{
  "name": "conceptbridge",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @conceptbridge/api\" \"npm run dev -w @conceptbridge/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed": "npm run seed -w @conceptbridge/api"
  },
  "devDependencies": { "concurrently": "^9.1.2", "typescript": "^5.7.3", "vitest": "^2.1.8" },
  "engines": { "node": ">=20.0.0", "npm": ">=10.0.0" }
}

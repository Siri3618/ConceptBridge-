NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/conceptbridge
SESSION_SECRET=replace-with-at-least-32-random-characters
WEB_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=
# Set this to the Render API origin on Vercel, e.g. https://conceptbridge-api.onrender.com
# Leave blank locally; Vite proxies /api to localhost:4000.
VITE_API_BASE_URL=
# Optional first administrator account; set these only when running npm run seed:admin.
# ADMIN_EMAIL=admin@your-school.example
# ADMIN_NAME=School Administrator
# ADMIN_PASSWORD=replace-with-a-unique-12-character-or-longer-password
